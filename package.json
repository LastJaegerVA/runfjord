{
  "name": "runfjord",
  "productName": "Runfjord",
  "version": "1.7.0",
  "description": "Keep all your scripts in one library, with a note on what each one does, and run them with one click.",
  "main": "main.js",
  "author": {
    "name": "LastJaegerVA",
    "email": "LastJaegerVA@users.noreply.github.com",
    "url": "https://github.com/LastJaegerVA"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node tools/check-locales.js",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "io.github.lastjaegerva.runfjord",
    "productName": "Runfjord",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "build/icons/**/*",
      "LICENSE"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "artifactName": "Runfjord-${version}-x86_64.AppImage",
      "icon": "build/icons",
      "maintainer": "LastJaegerVA <LastJaegerVA@users.noreply.github.com>",
      "synopsis": "Keep all your scripts in one place and run them with one click"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Runfjord-Setup-${version}.exe",
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Runfjord-${version}-Windows-Portable.exe"
    },
    "publish": null,
    "executableName": "runfjord",
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libnotify",
        "libxtst",
        "xdg-utils"
      ],
      "artifactName": "runfjord-x86_64.pkg.tar.xz"
    },
    "copyright": "Copyright © 2026 Jonas Olsen-Sund (LastJaegerVA)"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "desktopName": "runfjord.desktop",
  "keywords": [
    "scripts",
    "script-manager",
    "launcher",
    "electron",
    "bash",
    "powershell",
    "python",
    "desktop"
  ],
  "homepage": "https://github.com/LastJaegerVA/runfjord",
  "repository": {
    "type": "git",
    "url": "https://github.com/LastJaegerVA/runfjord.git"
  }
}
